# nunca precisa estar versionado.
conteudo/ciclos/*/B0-newsletters.md

# vídeo grande, fora do git desde 01/09/2026 (travava o push, acima do limite do GitHub)
codigo/site/pitch-serasa/img/final - cópia.mp4
.export-*

# Obsidian. O cofre é "Segundo Cérebro/", então a config dele fica em "Segundo Cérebro/.obsidian/".
# graph.json ENTRA no git: é ele que carrega as cores dos 6 setores do grafo. O que fica
# de fora é só estado de janela, que muda a cada clique e polui o diff.
Segundo Cérebro/.obsidian/workspace.json
Segundo Cérebro/.obsidian/workspace-mobile.json
Segundo Cérebro/.obsidian/cache
# vault antigo da raiz inteira, aposentado: graficava 79 mil arquivos sem sentido.
# A barra inicial é obrigatória: sem ela o padrão casa QUALQUER pasta .obsidian do repo,
# inclusive a do cofre, e engole as cores do grafo.
/.obsidian/

# Tema e plugin de terceiros do cofre: reinstaláveis, não versionar
Segundo Cérebro/.obsidian/themes/
Segundo Cérebro/.obsidian/plugins/
