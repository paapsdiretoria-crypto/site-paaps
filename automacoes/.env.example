# .env.example - modelo de chaves das automações PAAPS
#
# Como usar: copie este arquivo para ".env" (sem .example) na mesma pasta e preencha
# com os valores reais. O ".env" fica só no seu computador; o .gitignore proíbe ele de
# subir para o GitHub. NUNCA coloque valores reais neste arquivo .env.example.
#
# Cada linha e' NOME_DA_CHAVE=valor_falso. Substitua "COLE_AQUI..." pelo valor real no
# seu .env.

# === Frente 1: Tráfego pago ===
LINKEDIN_ADS_ACCESS_TOKEN=COLE_AQUI_O_TOKEN_LINKEDIN_ADS
GOOGLE_ADS_DEVELOPER_TOKEN=COLE_AQUI_O_DEVELOPER_TOKEN_GOOGLE_ADS
GOOGLE_ADS_CLIENT_ID=COLE_AQUI_O_CLIENT_ID
GOOGLE_ADS_CLIENT_SECRET=COLE_AQUI_O_CLIENT_SECRET
GOOGLE_ADS_REFRESH_TOKEN=COLE_AQUI_O_REFRESH_TOKEN
META_ADS_ACCESS_TOKEN=COLE_AQUI_O_TOKEN_META_ADS
META_ADS_ACCOUNT_ID=COLE_AQUI_O_ID_DA_CONTA_DE_ANUNCIOS

# === Frente 2: Pipeline de conteúdo ===
# A maior parte roda via agentes do Claude Code; chaves de mídia entram aqui se preciso.
HEYGEN_API_KEY=COLE_AQUI_SE_USAR_HEYGEN
ELEVENLABS_API_KEY=COLE_AQUI_SE_USAR_ELEVENLABS

# === Frente 3: Crescimento no Instagram ===
WINDSOR_AI_API_KEY=COLE_AQUI_A_CHAVE_WINDSOR_AI
INSTAGRAM_GRAPH_TOKEN=COLE_AQUI_O_TOKEN_INSTAGRAM_GRAPH

# === Frente 4: Funil de leads (destino: Notion, base "Leads") ===
NOTION_TOKEN=COLE_AQUI_O_TOKEN_DA_INTEGRACAO_NOTION
NOTION_LEADS_DATABASE_ID=22244cb52e008142b15bf53c15ae38c0

# === Frente 5: Prospecção fria por e-mail (ferramenta: Resend) ===
# A chave do Resend começa com "re_". Pega em resend.com > API Keys > Create.
RESEND_API_KEY=COLE_AQUI_A_CHAVE_DO_RESEND
EMAIL_REMETENTE=relacionamento@paaps.com.br
EMAIL_DOMINIO_PROSPECCAO=paaps.com.br

# === Infra compartilhada ===
N8N_ENCRYPTION_KEY=COLE_AQUI_A_CHAVE_DE_CRIPTOGRAFIA_DO_N8N
