{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site-paaps",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080",
        "--directory",
        "codigo/site"
      ],
      "port": 8080
    },
    {
      "name": "pitch-serasa-v5",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "codigo/site/pitch-serasa/deck-v5"
      ],
      "port": 3210
    },
    {
      "name": "pitch-serasa-v5-verify",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "PORT=3211 npm run dev --prefix codigo/site/pitch-serasa/deck-v5"
      ],
      "port": 3211
    },
    {
      "name": "pitch-v4-estatico",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8123",
        "--directory",
        "codigo/site"
      ],
      "port": 8123
    }
  ]
}
